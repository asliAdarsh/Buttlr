# ---- application -------------------------------------------------------
APP_NAME=Buttlr
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- logging -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# ---- auth --------------------------------------------------------------
# dev      -> Buttlr issues its own JWTs (no cloud account needed)
# firebase -> verify Firebase ID tokens with the Admin SDK
AUTH_MODE=dev
DEV_AUTH_SECRET=buttlr-dev-secret-change-me-in-production
DEV_AUTH_TTL_HOURS=168
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# ---- storage -----------------------------------------------------------
# auto -> Firestore when Firebase is configured, otherwise the in-memory/file store
STORE_BACKEND=auto
FIRESTORE_EMULATOR_HOST=
MEMORY_STORE_PATH=.data/buttlr-store.json

# ---- secrets -----------------------------------------------------------
# Fernet key for encrypting integration credentials at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- runtime -----------------------------------------------------------
MAX_AGENT_STEPS=12
TOOL_TIMEOUT_SECONDS=60
EXECUTION_TIMEOUT_SECONDS=900
EXECUTION_WORKERS=4

# ---- models ------------------------------------------------------------
# Leave the keys empty to run on the built-in deterministic planner.
DEFAULT_PROVIDER=auto
DEFAULT_MODEL=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-latest
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GOOGLE_DEFAULT_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=
OLLAMA_DEFAULT_MODEL=qwen2.5:7b
ESTIMATED_COST_PER_1K_INPUT=0
ESTIMATED_COST_PER_1K_OUTPUT=0

# ---- integrations ------------------------------------------------------
# Nothing here is required to connect an app: each person connects their own GitHub/Jira/
# Google account under Integrations, and an owner or admin can connect one shared account
# for the workspace. Workspaces can also register their own OAuth app in the UI.
#
# These two are optional deployment-wide OAuth apps, used only when a workspace has not
# registered its own.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Where the provider redirects back after sign-in (must match the OAuth app's callback URL).
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# ---- scheduler ---------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
